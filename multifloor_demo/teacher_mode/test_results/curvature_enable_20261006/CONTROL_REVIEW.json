  "mathematics": {
    "reference": "kappa=d(spatial heading)/ds, kappa_rate=d2(spatial heading)/ds2; finite horizontal arc/chord heading, original 3D projection and raw path retained.",
    "curvature_term": "Logged yaw_PD.curvature_FF = v*kappa. yaw_D = 0.15*(v*kappa-filtered_yawrate), so total Euler yaw reference = 1.15*v*kappa + 1.3*heading_error - 0.15*filtered_yawrate.",
    "rate_budget": "Converted body-z yaw boundary to Euler-yaw space; subtract abs(yaw feedback) and 0.12 rad/s reserve, constrain abs(1.15*kappa)*v to remaining headroom.",
    "acceleration_budget": "0.8 - 0.2 = 0.6 rad/s^2 reference budget; abs(1.15*kappa_rate)*v^2 + abs(1.15*kappa)*abs(v-v_previous)/dt <= budget.",
    "path_jump": "Additional discrete abs(1.15*kappa*v - previous_curvature_yaw_reference) <= 0.6*dt; previous curvature reference and speed persist across set_path. Infeasible reference requests exact-zero constraint hold.",
    "gate": "Curvature branches only operate in drive. External align uses the locked heading, zero XY command and frozen XY integrals. Constraint hold freezes all velocity integrals, emits exact zero and marks replan pending in production wrapper.",
    "downstream": "Unchanged bounded PI output and production command slew [.6,.6,.8]; protection and constraint hold deliberately bypass normal slew to zero.",
    "tail": "At fixed-goal short tail <=0.15 m, heading is fixed-goal yaw and curvature becomes unavailable/zero; this existing tail/capture behavior is retained."
  },
