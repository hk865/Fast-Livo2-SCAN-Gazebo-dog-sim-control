  "semantics": {
    "origin": {
      "0": "none",
      "1": "primary voxel or its actual recursive leaf",
      "2": "actual fallback neighbor or its actual recursive leaf"
    },
    "counterfactual_neighbor": "compute same comparison thresholds using pv.point_w (meters), preserving original primary key; only a read-only existence lookup, never matched or used by estimator",
    "invalid_or_absent": "NaN for absent neighbor coordinates and unmatched selection scalars; candidate min/max remain +/-inf if no candidate evaluated; x/y normal NaN when is_plane=false",
    "plane_identity": "plane_id plus selected tree center/layer; IDs not stable across runs",
    "plane_age": "born on first actual init_plane attempt; update counter increments on every init_plane attempt, including rejected nonplane result",
    "covariance_after": "same as before on nonterminal iterations, original final covariance update retained",
    "total_rejections": "candidate/node counts, not mutually exclusive per-point rejection reasons; use final_matched/primary_matched to disambiguate successful alternative"
  },
