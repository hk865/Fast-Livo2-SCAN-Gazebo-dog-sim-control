                        dict(schema='r85_dynamic_pretrigger_record/v1' if pretrigger else 'r85_dynamic_obstacle_record/v1',kind=kind,
                        sequence=sequence,binding=dict(self.binding),sim_ns=self.ns(),monotonic_wall=time.monotonic(),
