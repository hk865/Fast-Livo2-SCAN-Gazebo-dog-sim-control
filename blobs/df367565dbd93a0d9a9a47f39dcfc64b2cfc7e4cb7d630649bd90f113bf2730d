"""Integration-only freeze; executable production sources stay at R29 baseline."""
from pathlib import Path
from datetime import datetime, timezone
import hashlib
import json
import sys

T = Path('/opt/experiment/history/2026-10-07/task/go2_engineering_v33')
S = T / 'R30_BASELINE_TEMPORAL_CAPTURE_STAGE'
V = Path('/opt/experiment/workspace/multifloor_demo/teacher_mode/navigation/engineering_v34_continuous_known_map')
I = T / 'R30_MONITOR_INDEPENDENT_REVIEW/REVIEW.json'
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()
read = lambda p: json.loads(Path(p).read_text())

assert sha(V/'ENGINEERING_V34_PREFLIGHT.json') == sha(S/'BEFORE_ENGINEERING_V34_PREFLIGHT.json')
old = read(S/'BEFORE_ENGINEERING_V34_PREFLIGHT.json')
for path, digest in old['verified_inputs_sha256'].items():
    assert sha(path) == digest, path
review = read(I)
assert review['review_passed'] is True and review['blocking_findings'] == []
for path, digest in review.get('source_sha256', {}).items():
    assert sha(path) == digest, path
tests = read(S/'FINITE_TEST_RECEIPT_V2.json')
assert tests['tests_pass'] is True and tests['tests_run'] == 9
for path, digest in tests['source_sha256'].items():
    assert sha(path) == digest, path
assert read(S/'HOST_BEFORE_RETRY_CHECK.json')['all_saved_groups_absent']
sys.path[:0] = [str(V), str(V.parent), str(V.parents[2])]
import corridor_preflight as C
protected = C.unchanged_navigation_bindings(V)
gate = C.freeze_source_review(V,
    [T/'R29_PRODUCTION_CPU_RECEIPT.json', S/'FINITE_TEST_RECEIPT_V2.json'],
    [T/'R29_CAPTURE_INDEPENDENT_REVIEW/REVIEW.json', I], root_review_complete=True)
# Explicit direct hashes supplement the normal transitive test/review bindings.
for path in [S/'run_once_bounded.py', S/'monitor_tests.py', S/'FINITE_TESTS_V2.log',
             S/'HOST_BEFORE_RETRY_CHECK.json', S/'freeze_reviewed_monitor.py']:
    gate['verified_inputs_sha256'][str(path)] = sha(path)
(V/C.GATE_NAME).write_text(json.dumps(gate, indent=2)+'\n')
from full46_launch_contract import PROFILE_NAMES
for name in PROFILE_NAMES:
    C.verify_preflight(V, read(V/'profiles'/name))
assert C.unchanged_navigation_bindings(V) == protected
for path, digest in old['verified_inputs_sha256'].items():
    if path != str(V/C.REVIEW_NAME):
        assert sha(path) == digest, path
from storage_guard import observe
storage = observe(V, read(V/'profiles/engineering_nav46.json'), count_files=True)
receipt = dict(schema='R30_reviewed_monitor_retry_source_freeze/v1', utc=datetime.now(timezone.utc).isoformat(),
    gate_sha256=sha(V/C.GATE_NAME), bindings=len(gate['verified_inputs_sha256']),
    monitor_sha256=sha(S/'run_once_bounded.py'), independent_review_passed=True,
    independent_review_sha256=sha(I), baseline_sources_unchanged=True,
    original_matcher_sha256=sha(V/'known_scene_matcher.py'), production_localization_or_control_changes=0,
    protected_sources=len(protected), profiles_unchanged=len(PROFILE_NAMES), monitor_tests=9,
    prior_failure_preserved=True, R29_original_gate_sha256=sha(S/'BEFORE_ENGINEERING_V34_PREFLIGHT.json'),
    simulation_started=False, storage=storage)
with (T/'R30_SOURCE_FREEZE_RECEIPT.json').open('x') as stream:
    json.dump(receipt,stream,ensure_ascii=False,indent=2);stream.write('\n')
print(json.dumps({k:receipt[k] for k in ['gate_sha256','bindings','monitor_sha256','production_localization_or_control_changes','monitor_tests']},ensure_ascii=False))
