"""Unique integration owner source freeze; never starts a simulator."""
from pathlib import Path
import datetime
import hashlib
import json
import sys

N=Path(__file__).resolve().parent
C=Path('/opt/experiment/workspace/multifloor_demo/teacher_mode/navigation/engineering_v34_r37_rows_event')
sys.dont_write_bytecode=True
sys.path.insert(0,str(C))
import corridor_preflight as cp
sha=lambda p:hashlib.sha256(Path(p).read_bytes()).hexdigest()
finite=N/'FINITE_CPU_FINAL_RECEIPT.json'
independent=N/'INDEPENDENT_FINAL_EVIDENCE_REVIEW.json'
root=N/'ROOT_FINAL_EVIDENCE_RECONCILIATION.json'
assert json.loads(finite.read_text())['tests_run']==74
for path in (independent,root):
    d=json.loads(path.read_text())
    assert d['review_passed'] and not d['blocking_findings']
for name in (cp.GATE_NAME,cp.REVIEW_NAME):
    with (N/('PREVIOUS_COPIED_'+name)).open('xb') as f:
        f.write((C/name).read_bytes())
gate=cp.freeze_source_review(C,[str(finite)],
    [str(N/'INDEPENDENT_SOURCE_REVIEW.json'),str(independent),str(root)],root_review_complete=True)
extra=[N/'AUTHORITY.json',N/'BOUNDED_DIAGNOSTIC_READINESS_DECISION.json',
    N/'GC_FINAL_CONTROLLED_RESULT.json',N/'COLD_PROBE_ATTEMPT2_SCOPE_ADDENDUM.json',
    N/'GC_SAVED_ARRAY_PREFIX_COMPARISON.json',N/'gc_cpu/CPU_EXECUTION_LEDGER.json',
    N/'SOURCE_CHANGE_FINAL_REVIEW.json',N/'FINAL_CANDIDATE.diff',Path(__file__)]
for receipt in (finite,N/'GC_FINAL_CONTROLLED_RESULT.json'):
    d=json.loads(receipt.read_text())
    for key in ('receipt_bindings','evidence_sha256'):
        for p,h in d.get(key,{}).items():
            assert sha(p)==h,p
            extra.append(Path(p))
gate['verified_inputs_sha256'].update({str(p):sha(p) for p in extra})
gate['diagnostic_scope']='authorized bounded original-route event capture; formal late Actor IPC and full46 acceptance UNVERIFIED'
(C/cp.GATE_NAME).write_text(json.dumps(gate,indent=2)+'\n')
profile=json.loads((C/'profiles/engineering_nav46.json').read_text())
cp.verify_preflight(C,profile)
result=dict(schema='R37_frozen_source_receipt/v1',utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
    candidate=str(C),gate=str(C/cp.GATE_NAME),gate_sha256=sha(C/cp.GATE_NAME),
    bindings=len(gate['verified_inputs_sha256']),current_finite_cases=74,
    independent_review=str(independent),independent_review_sha256=sha(independent),
    source_changes_stopped=True,simulation_started=False,formal_late_Actor_IPC_PASS=False,
    navigation_PASS=False,maximum_attempts=1)
with (N/'SOURCE_FREEZE.json').open('x') as f:
    f.write(json.dumps(result,indent=2)+'\n')
print(json.dumps(result))
