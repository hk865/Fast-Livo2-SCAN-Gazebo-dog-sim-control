def validate_metadata(profile,document):
    """Pure metadata validation, also usable before the new files are installed."""
    if type(document)is not dict or document!=EXPECTED_METADATA:
        raise ValueError('R42 resource proof metadata differs')
    if type(profile)is not dict:raise ValueError('Resource profile must be an object')
    option=profile.get(KEY)
    if type(option)is not dict or set(option)!=set(CONFIG) or any(type(option[k])is not type(v) or option[k]!=v for k,v in CONFIG.items()):
        raise ValueError('Exact explicitly selected R42 resource option required')
    s=profile.get('r85_session',{});d=profile.get('diagnostic_observe_only',{})
    if (type(s)is not dict or s.get('enabled')is not True or s.get('simulation_only')is not True
            or s.get('deadline_utc')!=DEADLINE_UTC
            or type(s.get('maximum_retained_bytes'))is not int or s['maximum_retained_bytes']!=HARD_BYTES
            or type(s.get('maximum_round_bytes'))is not int or s['maximum_round_bytes']!=ROUND_BYTES
            or type(d)is not dict or d.get('enabled')is not True
            or d.get('schema')!='r85_existing_diagnostic_business_observation/v1'
            or d.get('simulation_only')is not True or d.get('maximum_physics_rounds')!=1
            or d.get('self_imposed_work_deadline_withdrawn')is not False
            or d.get('formal_acceptance_pass_allowed')is not False
            or d.get('navigation_truth_injection')is not False
            or d.get('user_authorized_work_deadline_utc')!=DEADLINE_UTC or d.get('work_deadline_basis')!=BASIS
            or profile.get('navigation_ground_truth_used')is not False
            or profile.get('controller_kind')!='student' or profile.get('actor_kind')!='student'):
        raise ValueError('Renewed resource scope/deadline/capacity differs')
    duration=profile.get('duration_s')
    if type(duration)not in(int,float) or not math.isfinite(duration) or not 30<=duration<=1500:
        raise ValueError('Original finite native duration required')
    if profile.get('raw_storage_budget')!={'max_run_bytes':HARD_BYTES,'minimum_start_available_bytes':107374182400,'minimum_runtime_available_bytes':107374182400}:
        raise ValueError('Renewal must retain original filesystem reserves')
    if (s.get('resource_renewal_proof')!=str(PROOF_PATH)
            or s.get('resource_renewal_proof_sha256')!=PROOF_SHA256):
        raise ValueError('Resource proof exact path/SHA binding differs')
    return dict(deadline_utc=DEADLINE_UTC,maximum_retained_bytes=HARD_BYTES,
        maximum_round_bytes=ROUND_BYTES,soft_stop_bytes=SOFT_BYTES,finish_reserve_s=300,
        proof_path=str(PROOF_PATH),proof_sha256=PROOF_SHA256)

def configuration(profile):
    if type(profile)is not dict:return None
    option=profile.get(KEY)
    if option is None:return None
    if type(option)is not dict or type(option.get('enabled'))is not bool:
        raise ValueError('Resource renewal requires a strict object/boolean')
    if option=={'enabled':False}:return None
    # Do not accept False with extra keys, int booleans or an unselected option.
    if option!=CONFIG or any(type(option.get(k))is not type(v)for k,v in CONFIG.items()):
        raise ValueError('Unknown resource renewal configuration')
    if PROOF_PATH.is_symlink() or not PROOF_PATH.is_file() or PROOF_PATH.stat().st_size>65536:
        raise ValueError('Resource proof must be an installed bounded regular file')
    raw=PROOF_PATH.read_bytes()
    if hashlib.sha256(raw).hexdigest()!=PROOF_SHA256:raise ValueError('Resource proof bytes changed')
    result=validate_metadata(profile,json.loads(raw))
    for ref in EXPECTED_METADATA['source_authority']:
        p=Path(ref['path'])
        if p.is_symlink() or not p.is_file() or p.stat().st_size!=ref['bytes'] or hashlib.sha256(p.read_bytes()).hexdigest()!=ref['sha256']:
            raise ValueError('Explicit resource authority changed '+str(p))
    return result

def retained_hard_bytes(profile,legacy=130000000000):
    selected=configuration(profile)
    return selected['maximum_retained_bytes'] if selected is not None else legacy
