"""CPU-only regression of authorized stop behavior and preserved safety."""
from pathlib import Path
import ast
import datetime as dt
import hashlib
import json
import sys
import tempfile
import types
import unittest
from unittest.mock import patch

S = Path(__file__).resolve().parent
C = Path('/opt/experiment/workspace/multifloor_demo/teacher_mode/navigation/engineering_v34_r40_continue_original_route')
B = C.with_name('engineering_v34_r39_p1_association')
sys.path.insert(0,str(C))
import first_goal_stop as stop
sha = lambda p: hashlib.sha256(Path(p).read_bytes()).hexdigest()

class Stops(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix='go2_r40_finite_')
        self.run = Path(self.tmp.name)/'finite'
        self.run.mkdir()
        self.state = {}
        self.stub = types.ModuleType('startup_trace')
        self.stub.read_live_json = lambda p:self.state.get(Path(p).name)
        self.modules = patch.dict(sys.modules,{'startup_trace':self.stub})
        self.modules.start()
    def tearDown(self):
        self.modules.stop();self.tmp.cleanup()
    def decide(self,ns=100_000_000_000,wall=100,bytes_=100):
        return stop.first_goal_stop_decision(self.run,ns,wall,bytes_)
    def test_sampling_completion_and_expiry_do_not_stop(self):
        m = types.ModuleType('event_aware_source_capture')
        def forbidden(*a):raise AssertionError('soft hint must not be consulted')
        m.diagnostic_stop_hint=forbidden
        with patch.dict(sys.modules,{'event_aware_source_capture':m}):
            for ns in (18_625_000_000,30_000_000_000,121_000_000_000,1_499_999_999_999):
                d=self.decide(ns=ns);self.assertFalse(d['stop']);self.assertFalse(d['navigation_PASS'])
    def test_native_total_cap_boundary(self):
        self.assertFalse(self.decide(ns=1_499_999_999_999)['stop'])
        self.assertEqual(self.decide(ns=1_500_000_000_000)['reason'],'native1500s_original_route_total_cutoff')
    def test_wall_total_cap_boundary(self):
        self.assertFalse(self.decide(wall=9089.999)['stop'])
        self.assertEqual(self.decide(wall=9090)['reason'],'wall9090s_original_route_total_cutoff')
    def test_output_cap_boundary(self):
        self.assertFalse(self.decide(bytes_=4_999_999_999)['stop'])
        self.assertEqual(self.decide(bytes_=5_000_000_000)['reason'],'new_output_cap')
    def test_original_mission_failure_and_abort(self):
        for value in ('failed','aborted'):
            self.state['mission46_status.json']={'run_id':self.run.name,'stage':value}
            d=self.decide();self.assertEqual(d['reason'],'actual_original_mission_failed');self.assertFalse(d['navigation_PASS'])
    def test_original_navigation_failure_and_abort(self):
        for value in ('failed','aborted'):
            self.state['navigation_status.json']={'state':value}
            self.assertEqual(self.decide()['reason'],'actual_original_navigation_failed')
    def test_nonrecoverable_initialization_rejection(self):
        self.state['R33_INITIALIZATION_RESULT.json']={'original_verifier_passed':False}
        d=self.decide();self.assertEqual(d['reason'],'actual_initialization_nonrecoverable_rejection');self.assertFalse(d['initialization_diagnostic']['recoverable_wait'])
    def test_native_fault_priority_over_all_caps(self):
        row={'data':{'fault':'original_body_contact'}}
        d=stop.first_goal_runtime_decision(self.run,{'fault_record':row,'native_ns':1_600_000_000_000,'caught_up':False},9999,6_000_000_000)
        self.assertEqual(d['reason'],'actual_original_native_fault');self.assertIs(d['actual_fault_record'],row);self.assertFalse(d['navigation_PASS'])
    def test_rejected_result_update_guard_preserved(self):
        tree=ast.parse((C/'known_scene_runtime.py').read_text())
        tick=next(n for n in ast.walk(tree) if isinstance(n,ast.FunctionDef) and n.name=='tick')
        checks=[n for n in ast.walk(tick) if isinstance(n,ast.If) and isinstance(n.test,ast.BoolOp) and isinstance(n.test.op,ast.And) and 'accepted' in ast.unparse(n.test) and 'evidence_verified' in ast.unparse(n.test)]
        self.assertEqual(len(checks),1)
        test=compile(ast.Expression(checks[0].test),'<actual tick acceptance>','eval')
        for accepted,verified in [(False,False),(False,True),(True,False)]:
            self.assertFalse(eval(test,{},dict(result={'accepted':accepted,'evidence_verified':verified})))
        self.assertTrue(eval(test,{},dict(result={'accepted':True,'evidence_verified':True})))
        self.assertEqual(sha(C/'known_scene_runtime.py'),sha(B/'known_scene_runtime.py'))
    def test_frozen_algorithm_profiles_and_safety_sources(self):
        d=json.loads((S/'ISOLATED_CANDIDATE_COPY.json').read_text())
        allowed=set(d['changed'])
        for rel,h in d['base_sha256'].items():
            self.assertEqual(sha(B/rel),h)
            if rel not in allowed:self.assertEqual(sha(C/rel),h)
        contract=json.loads((C/'R33_SHORT_STARTUP_CONTRACT.json').read_text())
        self.assertFalse(contract['GT_carrier_allowed']);self.assertTrue(contract['original_correction_freshness_gate_preserved'])

result=unittest.TextTestRunner(verbosity=2).run(unittest.defaultTestLoader.loadTestsFromTestCase(Stops))
sources={str(C/x):sha(C/x) for x in ['first_goal_stop.py','run.py','R33_SHORT_STARTUP_CONTRACT.json','POLICY_SELECTION_CONTRACT.json','EVENT_CAPTURE_CONTRACT_TEMPLATE.json','known_scene_runtime.py','storage_guard.py','storage_recovery.py','corridor_preflight.py']}
sources[str(Path(__file__).resolve())]=sha(__file__)
d=dict(schema='R40_finite_stop_CPU_receipt/v1',utc=dt.datetime.now(dt.timezone.utc).isoformat(),tests_pass=result.wasSuccessful(),tests_run=result.testsRun,failures=len(result.failures),errors=len(result.errors),source_sha256=sources,ROS_Gazebo_Actor_started=False,GT_carrier_used=False,navigation_PASS=False,limitations='Finite stop/unchanged-source checks; no actual route or timing acceptance')
(S/'FINITE_CPU_RECEIPT.json').write_text(json.dumps(d,indent=2)+'\n')
raise SystemExit(0 if result.wasSuccessful() else 1)
