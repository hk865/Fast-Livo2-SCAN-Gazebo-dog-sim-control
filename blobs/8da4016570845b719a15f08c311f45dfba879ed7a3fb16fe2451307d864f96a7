def actual_ack(input_s, *, sequence=None, frame=None, inference=None,
               request=(0.,0.,0.), applied=(0.,0.,0.), scope=SCOPE):
    stamp=round(input_s*1e9);seq=round(input_s*100) if sequence is None else sequence
    frame=seq if frame is None else frame;inference=seq if inference is None else inference
    ack=dict(stamp_ns=stamp,received_wall_ns=10_000_000_000+stamp+25_000_000,
        sequence=seq,ack_native_clock_ns=stamp+20_000_000,
        requested_command_body=list(request),applied_command_body=list(applied),
        actor_kind='student',actual_checkpoint_sha256=CHECKPOINT_SHA,
        actual_export_sha256=EXPORT_SHA,student_contract_sha256=CONTRACT_SHA,
        source_scope_sha256=scope,actual_actor_input=dict(actor_inferred_this_frame=True,
            exact_native45_used=True,action_finite=True,hidden_finite=True,actor_kind='student',
            actor_observation_dimension=45,teacher247_used_for_student_inference=False,
            export_sha256=EXPORT_SHA,checkpoint_sha256=CHECKPOINT_SHA,input_clock_ns=stamp,
            frame_serial=frame,inference_sequence=inference,actual_observation_command_body=list(applied)))
    pid=dict(schema=PID_SCHEMA,actual_input_clock_ns=stamp,actual_frame_serial=frame,
        requested_command_body=list(request),final_after_legacy_slew_body=list(applied),
        effective_command_bounds=[.3,.2,.3],pid_correction=[0.,0.,0.],
        pid_raw_correction=[0.,0.,0.],corrected_before_legacy_slew_body=np.clip(request,[-.3,-.2,-.3],[.3,.2,.3]).tolist(),
        authoritative_zero=not any(request),ordinary_zero_takeover=False)
    annotate_pending(ack,pid,LOWER_ACK_CONFIG,[.6,.2,.6])
    bind_causal_ack(ack,LOWER_ACK_CONFIG)
    return ack

def bind_ack(g,ack,control_s, *, scope=SCOPE,context=CONTEXT):
    return g.bind_zero_ack(ack,scope,context['request_id'],context['waypoint_index'],
        round(control_s*1e9),round((10+control_s)*1e9))

def observe(g,t, *, zero=True, gyro=(0.,0.,0.), velocity=(0.,0.,0.), wz=0.,
            wall=None,gyro_stamp=None):
    return g.observe(t,10+t if wall is None else wall,list(velocity),wz,list(gyro),
        t if gyro_stamp is None else gyro_stamp,zero,position=[0.,0.,.32],quaternion=[0.,0.,0.,1.])

def enter_brake(*, deadline=20.):
    g=gate_module.TeacherHeadingGate(profile())
    g.set_transition_context('heading_change',copy.deepcopy(CONTEXT))
    g.bind_handoff_deadline(deadline,dict(request_id=CONTEXT['request_id'],waypoint_index=3,
        source='original_waypoint_deadline'))
    g.phase='align';g.heading=0.
    assert bind_ack(g,actual_ack(.95),1.)
    observe(g,1.,zero=False)
    g.update(1.,.01,0.,11.)
    assert g.controlled_braking
    return g

def enter_final(*, publication=True):
    g=enter_brake()
    for t in [1.1,1.2,1.3,1.4]:
        assert bind_ack(g,actual_ack(t-.05),t)
        observe(g,t,zero=True)
        g.update(t,.01,0.,10+t)
    assert g.settle_control_stage=='authoritative_zero'
    if publication:g.note_zero_publication(1_405_000_000)
    return g

