def sources(stamp, *, gyro=(0.,0.,0.), quaternion=(1.,0.,0.,0.),
            position=(0.,0.,.32), velocity=(0.,0.,0.), wall=None):
    wall = 10_000_000_000 + stamp if wall is None else wall
    pose = dict(stamp_ns=stamp, received_wall_ns=wall, frame_id='camera_init',
                position_world_xyz=list(position), quaternion_wxyz=list(quaternion),
                origin_velocity_body=list(velocity))
    imu = dict(stamp_ns=stamp-10_000_000, received_wall_ns=wall-10_000_000,
               frame_id='body', angular_velocity_body=list(gyro))
    ack = dict(stamp_ns=stamp-5_000_000, received_wall_ns=wall-5_000_000,
               sequence=stamp//1_000_000, requested_command_body=[0.,0.,0.],
               applied_command_body=[0.,0.,0.])
    return pose, imu, ack, stamp+5_000_000, wall

def controller(module=core, **config):
    c = module.Controller(dict(desired_speed=.2, external_heading_gate=True, **config),
                          [4.,0.,.32],0.,'fixed-test-goal')
    c.set_path([[0.,0.,.32],[4.,0.,.32]],'checked-scan',0,0)
    return c

def quaternion(roll, pitch, yaw):
    cr,sr=math.cos(roll/2),math.sin(roll/2)
    cp,sp=math.cos(pitch/2),math.sin(pitch/2)
    cy,sy=math.cos(yaw/2),math.sin(yaw/2)
    return [cr*cp*cy+sr*sp*sy,sr*cp*cy-cr*sp*sy,
            cr*sp*cy+sr*cp*sy,cr*cp*sy-sr*sp*cy]

def production_method(file, name, extra=None):
    tree = ast.parse((CANDIDATE/file).read_text())
    fn = next(n for n in ast.walk(tree) if isinstance(n, ast.FunctionDef) and n.name==name)
    namespace = dict(np=np, math=math, copy=copy, hashlib=hashlib, json=json,
                     Path=Path, time=__import__('time'))
    namespace.update(extra or {})
    exec(compile(ast.fix_missing_locations(ast.Module(body=[fn],type_ignores=[])),
                 str(CANDIDATE/file), 'exec'), namespace)
    return namespace[name]

