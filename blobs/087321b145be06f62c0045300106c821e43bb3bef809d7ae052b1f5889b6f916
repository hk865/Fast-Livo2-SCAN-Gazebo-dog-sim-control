"""Build one fresh ACK SCAN package; retain the complete predecessor closure."""
from pathlib import Path
import argparse
import datetime
import difflib
import hashlib
import json
import os
import re
import shlex
import shutil
import subprocess
import time

HERE = Path(__file__).resolve().parent
STAGE = HERE.parent
BUNDLE = STAGE/'candidate_bundle'
WORKSPACE = BUNDLE/'scan_ws'
BASE = Path('/opt/experiment/history/2026-10-14/task/r83_demo/implementation_attempt_20261014/r85_direction_boundary_release_20261014')
OLD_WS = BASE/'candidate_bundle/scan_ws'
OLD_TRAJ = BASE/'candidate_bundle/traj_utils_ws/install/traj_utils'
C66 = Path('/opt/experiment/workspace/multifloor_demo/teacher_mode/navigation/engineering_v66_r85_turn_handoff_candidate')
PREDECESSOR = C66/'R85_SCAN_WORKSPACE_CONTRACT.json'
PREDECESSOR_SHA = '65eff98c486305979571d0a6139cf9caeafeced59a3203025b57fb451a4420b2'
OLD_ENV = Path('/opt/experiment/workspace/multifloor_demo/teacher_mode/runs/20261014T175827Z_closed_loop_R85_f1_f3_dynamic_live_02_5b9a/navigation_stack_effective_environment.json')
PROJECT = Path('/opt/experiment/workspace')

def sha(p):
    return hashlib.sha256(Path(p).read_bytes()).hexdigest()

def identity(p):
    p=Path(p).resolve()
    return dict(path=str(p), bytes=p.stat().st_size, sha256=sha(p))

def write(path,data):
    Path(path).write_text(json.dumps(data,ensure_ascii=False,indent=2)+'\n')

def run(command, env, history, name, timeout):
    print(json.dumps(dict(phase='start',name=name,command=command)),flush=True)
    start=time.monotonic()
    result=subprocess.run(command,cwd=WORKSPACE,env=env,capture_output=True,text=True,timeout=timeout)
    row=dict(name=name,command=command,returncode=result.returncode,wall_s=time.monotonic()-start,
             stdout=result.stdout,stderr=result.stderr)
    history.append(row)
    write(HERE/'CHILD_ACK_BUILD_COMMANDS.json',history)
    print(json.dumps(dict(phase='done',name=name,returncode=result.returncode,wall_s=row['wall_s'])),flush=True)
    if result.returncode:
        print(result.stdout[-3500:]+result.stderr[-3500:],flush=True)
        raise SystemExit(result.returncode)
    return result

def build(args):
    if sha(PREDECESSOR)!=PREDECESSOR_SHA:
        raise RuntimeError('Predecessor contract identity differs')
    old=json.loads(PREDECESSOR.read_text())
    if (len(old['bindings_sha256']),len(old['source_bindings_sha256']),len(old['project_link_input_bindings_sha256']))!=(552,124,12):
        raise RuntimeError('Predecessor complete closure count differs')
    for path,digest in old['bindings_sha256'].items():
        if sha(path)!=digest:
            raise RuntimeError('Frozen predecessor changed: '+path)
    replacements={
        'src/scan_replan_fsm.cpp':(STAGE/'staged/scan_replan_fsm.cpp',args.cpp_sha),
        'include/plan_manage/scan_replan_fsm.h':(STAGE/'staged/scan_replan_fsm.h',args.header_sha),
        'include/plan_manage/fresh_child_odometry_ack.h':(STAGE/'staged/fresh_child_odometry_ack.h',args.helper_sha),
    }
    for relative,(source,digest)in replacements.items():
        if not re.fullmatch('[0-9a-f]{64}',digest) or sha(source)!=digest:
            raise RuntimeError('Explicit reviewed source freeze differs: '+str(source))
    if WORKSPACE.exists():
        raise RuntimeError('Fresh workspace already exists; inspect its outcome before any retry')
    (WORKSPACE/'src').mkdir(parents=True)
    dest=WORKSPACE/'src/plan_manage'
    shutil.copytree(OLD_WS/'src/plan_manage',dest,ignore=shutil.ignore_patterns('__pycache__','*.pyc'))
    for relative,(source,_)in replacements.items():
        target=dest/relative
        target.parent.mkdir(parents=True,exist_ok=True)
        target.write_bytes(source.read_bytes())
    rows=[]
    delta=[]
    for p in sorted(dest.rglob('*')):
        if not p.is_file():
            continue
        relative=str(p.relative_to(dest))
        source=replacements[relative][0]if relative in replacements else OLD_WS/'src/plan_manage'/relative
        if sha(source)!=sha(p):
            raise RuntimeError('Fresh source copy differs')
        rows.append([str(source.resolve()),str(p.resolve()),sha(p)])
        if relative in replacements:
            original=OLD_WS/'src/plan_manage'/relative
            before=original.read_text().splitlines(keepends=True)if original.exists()else[]
            delta.extend(difflib.unified_diff(before,p.read_text().splitlines(keepends=True),
                fromfile=str(original)if original.exists()else'/dev/null',tofile=str(p)))
    write(HERE/'ACK_SOURCE_COPY_SHA256.json',rows)
    (HERE/'ACK_CPP_DELTA.diff').write_text(''.join(delta))
    preserved=HERE/'PRESERVED_PRE_ACK_R85_SCAN_WORKSPACE_CONTRACT.json'
    preserved.write_bytes(PREDECESSOR.read_bytes())
    env=dict(os.environ)
    env.update({k:v for k,v in json.loads(OLD_ENV.read_text()).items()if isinstance(v,str)})
    env.update(OMP_NUM_THREADS='1',OPENBLAS_NUM_THREADS='1',MKL_NUM_THREADS='1')
    dirs={}
    for line in (OLD_WS/'build/scan_planner/CMakeCache.txt').read_text().splitlines():
        m=re.fullmatch(r'([A-Za-z0-9_]+_DIR):(?:PATH|UNINITIALIZED)=(.+)',line)
        if m and not m[1].startswith('AMENT_TEST_')and Path(m[2]).is_dir():
            dirs[m[1]]=m[2]
    dirs['traj_utils_DIR']=str(OLD_TRAJ/'share/traj_utils/cmake')
    cmake=['-DBUILD_TESTING=OFF','-DCMAKE_BUILD_TYPE=Release','-DPython3_EXECUTABLE=/usr/bin/python3',
           '-DCMAKE_EXPORT_COMPILE_COMMANDS=ON']+['-D'+k+'='+v for k,v in sorted(dirs.items())]
    command=['/usr/bin/colcon','build','--base-paths','src','--packages-select','scan_planner',
             '--executor','sequential','--cmake-args',*cmake,'--event-handlers','console_cohesion+']
    history=[]
    run(command,env,history,'fresh_scan_planner_colcon_build_and_install',600)
    executable=WORKSPACE/'install/scan_planner/lib/scan_planner/scan_planner_node'
    built=WORKSPACE/'build/scan_planner/scan_planner_node'
    config=WORKSPACE/'install/scan_planner/share/scan_planner/config/planner.yaml'
    if config.read_bytes()!=(OLD_WS/'install/scan_planner/share/scan_planner/config/planner.yaml').read_bytes():
        raise RuntimeError('Planner configuration changed')
    for relative,(_,digest)in replacements.items():
        if relative.startswith('include/'):
            installed=WORKSPACE/'install/scan_planner'/relative
            if sha(installed)!=digest:
                raise RuntimeError('Installed header differs: '+str(installed))
    build_dir=WORKSPACE/'build/scan_planner'
    link=build_dir/'CMakeFiles/scan_planner_node.dir/link.txt'
    actual_links=sorted({str(Path(token).resolve())for token in shlex.split(link.read_text())
        if Path(token).is_file()and (token.startswith(str(PROJECT)+'/')or Path(token).resolve()==(OLD_TRAJ/'lib/libtraj_utils.a').resolve())})
    if set(actual_links)!=set(old['project_link_input_bindings_sha256']):
        raise RuntimeError('Fresh build changed the exact12 reviewed project link inputs')
    for name in actual_links:
        if sha(name)!=old['project_link_input_bindings_sha256'][name]:
            raise RuntimeError('Frozen link dependency changed: '+name)
    for token in shlex.split(link.read_text()):
        p=Path(token)
        if (p.is_absolute()and p.is_file()and str(p.resolve())not in actual_links
                and not any(p.resolve().is_relative_to(root)for root in [Path('/usr'),Path('/lib'),Path('/opt/ros/jazzy')])):
            raise RuntimeError('Unexpected external link dependency: '+token)
    depfiles=sorted((build_dir/'CMakeFiles/scan_planner_node.dir').rglob('*.o.d'))
    helper=dest/'include/plan_manage/fresh_child_odometry_ack.h'
    if not any(str(helper)in p.read_text().replace('\\\n',' ')for p in depfiles):
        raise RuntimeError('New ACK helper is missing from actual compiler dependency files')
    for row in json.loads((build_dir/'compile_commands.json').read_text()):
        tokens=shlex.split(row['command'])
        if ([v for v in tokens if re.fullmatch('-O(?:[0-3sgz]|fast)',v)]!=['-O3']
                or '-DNDEBUG'not in tokens or any(v in tokens for v in ['-Ofast','-ffast-math','-ffinite-math-only','-funsafe-math-optimizations'])
                or not Path(row['file']).resolve().is_relative_to(dest)):
            raise RuntimeError('Fresh Release compiler flags/source scope differs')
    elf_history=[]
    for mode in ['-d','-n']:
        result=subprocess.run(['/usr/bin/readelf',mode,str(executable)],capture_output=True,text=True,check=True)
        elf_history.append(dict(command=['/usr/bin/readelf',mode,str(executable)],stdout=result.stdout))
    ld=subprocess.run(['/usr/bin/ldd',str(executable)],env=env,capture_output=True,text=True,check=True)
    write(HERE/'ACK_ELF_LINK_IDENTITY.json',dict(built=identity(built),installed=identity(executable),
        install_ELF_may_change_RPATH=True,readelf=elf_history,ldd_stdout=ld.stdout,actual_project_link_inputs=actual_links))
    fresh=[]
    for tree in [WORKSPACE/'src',WORKSPACE/'install']:
        fresh.extend(p.resolve()for p in tree.rglob('*')if p.is_file()and '__pycache__'not in p.parts and p.suffix!='.pyc')
    fresh.extend(build_dir/name for name in ['CMakeCache.txt','compile_commands.json','cmake_install.cmake','install_manifest.txt'])
    fresh.extend(p.resolve()for p in (build_dir/'CMakeFiles').rglob('*')
        if p.is_file()and (p.name in ['link.txt','flags.make']or p.name.endswith('.o.d')))
    fresh.append(built)
    fresh=sorted(set(Path(p).resolve()for p in fresh))
    receipt=HERE/'CHILD_ACK_COMPONENT_BUILD_RECEIPT.json'
    write(receipt,dict(schema='r85_scan_child_ack_component_build/v1',success=True,compile_only=True,build_exit_code=0,
        ROS_started=False,physics_started=False,source_algorithm_changed=False,optimization_algorithm_changed=False,
        original_gate_conditions_changed=False,scope='Add scope-bound actual odometry-consumed ACK only; old validator retained',
        executable=identity(executable),build_executable=identity(built),unchanged_project_link_input_count=12,
        new_helper_in_actual_compiler_dependencies=True,source_copy_manifest=str(HERE/'ACK_SOURCE_COPY_SHA256.json'),
        commands=str(HERE/'CHILD_ACK_BUILD_COMMANDS.json'),bindings=[identity(p)for p in fresh]))
    bindings=dict(old['bindings_sha256'])
    sources=dict(old['source_bindings_sha256'])
    for p in fresh+[PREDECESSOR,preserved,Path(__file__),receipt,HERE/'ACK_SOURCE_COPY_SHA256.json',
                    HERE/'ACK_CPP_DELTA.diff',HERE/'CHILD_ACK_BUILD_COMMANDS.json',HERE/'ACK_ELF_LINK_IDENTITY.json']:
        bindings[str(Path(p).resolve())]=sha(p)
    for original,copied,digest in rows:
        for p in [original,copied]:
            bindings[p]=digest
            sources[p]=digest
    contract=dict(schema='r85_scan_child_odometry_ack_workspace/v1',created_utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
        candidate='r85_scoped_child_odometry_consumption_ack_v1',candidate_root=str(C66),workspace=str(WORKSPACE.resolve()),
        protocol_version=1,executable=str(executable.resolve()),config=str(config.resolve()),build_receipt=str(receipt.resolve()),
        compile_only=True,runtime_acceptance_inherited=False,navigation_acceptance_established=False,
        actual_loaded_binary_witness_required=True,source_algorithm_changed=False,optimization_algorithm_changed=False,
        original_gate_conditions_changed=False,predecessor_contract=dict(path=str(PREDECESSOR),sha256=PREDECESSOR_SHA,
            snapshot=str(preserved),snapshot_sha256=sha(preserved),binding_count=552,source_count=124,link_count=12),
        source_copy_manifest=str(HERE/'ACK_SOURCE_COPY_SHA256.json'),source_bindings_sha256=sources,
        project_link_input_bindings_sha256=dict(old['project_link_input_bindings_sha256']),bindings_sha256=bindings,
        runtime_validation_status='BUILD_ONLY_NOT_NAVIGATION_PASS',child_ack_protocol='fresh_child_actual_odometry_consumption_v1')
    contract_path=HERE/'R85_SCAN_CHILD_ACK_WORKSPACE_CONTRACT.json'
    write(contract_path,contract)
    for path,digest in old['bindings_sha256'].items():
        if sha(path)!=digest:
            raise RuntimeError('Build changed predecessor closure: '+path)
    result=dict(status='compiled_not_installed_into_C66',contract=str(contract_path),contract_sha256=sha(contract_path),
        installed_executable=identity(executable),build_receipt=str(receipt),predecessor_bindings_preserved=552,
        predecessor_sources_preserved=124,bindings=len(bindings),sources=len(sources),project_link_inputs=12)
    write(HERE/'ACK_WORKSPACE_BUILD_RESULT.json',result)
    print(json.dumps(result),flush=True)

if __name__=='__main__':
    parser=argparse.ArgumentParser()
    parser.add_argument('--cpp-sha',required=True)
    parser.add_argument('--header-sha',required=True)
    parser.add_argument('--helper-sha',required=True)
    build(parser.parse_args())
