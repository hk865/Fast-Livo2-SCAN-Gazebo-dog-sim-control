T = Path('/opt/experiment/history/2026-10-07/task/go2_engineering_v33')
S = T/'R36_FULL_ROUTE_ACCEPTANCE_STAGE'
C = Path('/opt/experiment/workspace/multifloor_demo/teacher_mode/navigation/engineering_v34_r36_full_route_acceptance')
