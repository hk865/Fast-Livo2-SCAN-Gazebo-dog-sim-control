      <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material></visual></link></model>

    <!-- ===== Boxes on shelves (visual features for camera + LiDAR) ===== -->
    <model name="box_shelf1"><static>true</static><pose>-7.8 3.5 1.1 0 0 0.3</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.3 0.3 0.3</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 0.3 0.3</size></box></geometry>
      <material><ambient>0.9 0.1 0.1 1</ambient><diffuse>1.0 0.12 0.12 1</diffuse></material></visual></link></model>
    <model name="box_shelf2"><static>true</static><pose>-8.2 4.2 1.1 0 0 -0.2</pose>
