      <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material></visual></link></model>

    <!-- Row 3 (opposite side) -->
    <model name="rack3_col1"><static>true</static><pose>8 -5 1.0 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.1 2 2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 2 2</size></box></geometry>
