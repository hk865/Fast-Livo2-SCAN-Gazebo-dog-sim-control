    <model name="pillar1"><static>true</static><pose>6 -10 1.25 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry></collision>
      <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.5</length></cylinder></geometry>
