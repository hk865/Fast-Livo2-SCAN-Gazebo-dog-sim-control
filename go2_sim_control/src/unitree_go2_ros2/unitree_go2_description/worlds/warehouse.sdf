      <link name="link"><collision name="c"><geometry><box><size>0.1 2 2</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 2 2</size></box></geometry>
      <material><ambient>0.4 0.4 0.6 1</ambient><diffuse>0.5 0.5 0.75 1</diffuse></material></visual></link></model>
    <model name="rack2_shelf1"><static>true</static><pose>2 4 0.8 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.8 2.1 0.05</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.8 2.1 0.05</size></box></geometry>
      <material><ambient>0.5 0.35 0.2 1</ambient><diffuse>0.6 0.42 0.25 1</diffuse></material></visual></link></model>
    <model name="rack2_shelf2"><static>true</static><pose>2 4 1.5 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.8 2.1 0.05</size></box></geometry></collision>
