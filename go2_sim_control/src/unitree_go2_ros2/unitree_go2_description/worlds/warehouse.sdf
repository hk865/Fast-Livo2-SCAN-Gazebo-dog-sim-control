    <model name="box_shelf3"><static>true</static><pose>2.1 3.5 1.1 0 0 0.5</pose>
      <link name="link"><collision name="c"><geometry><box><size>0.3 0.2 0.35</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.3 0.2 0.35</size></box></geometry>
      <material><ambient>0.1 0.1 0.9 1</ambient><diffuse>0.12 0.12 1.0 1</diffuse></material></visual></link></model>

    <!-- ===== Scattered objects for LiDAR features ===== -->
    <model name="barrel_red"><static>true</static><pose>5 8 0.4 0 0 0</pose>
      <link name="link"><collision name="c"><geometry><cylinder><radius>0.4</radius><length>0.8</length></cylinder></geometry></collision>
